{
  "_readme": [
    "Population profiles for rsim. Figures come from the research report 'Pigmentation and body size in Western countries'.",
    "Status of each block: [S] sourced, [I] computed or interpolated from sources, [D] design choice (free to adjust).",
    "Percentages do not need to sum to 100: they are normalised on load.",
    "Hair categories: red, blond, light_brown (dark blond / light brown), dark_brown, black.",
    "Eye categories: blue (blue/grey), inter (green/hazel/intermediate), brown."
  ],
  "settings": {
    "official_only": true,
    "skin_sd_default": 5.0,
    "skin_val_shift": 0.0,
    "neutral_silhouette": 3.5,
    "minority_boost_under_30": 1.6,
    "child_blond_boost": 2.0,
    "teen_blond_boost": 1.4,
    "redhead_skin_shift": 3.0,
    "excluded_tones": [
      459182,
      459183,
      146066,
      459181
    ],
    "_excluded_tones": "[D] yellow, orange and bright red swatches: not plausible human skin (checked on tones_sheet.png)",
    "_status": "[D]",
    "_debug_log": "Write a [step] marker before each generation step, to locate EA's freeze bug",
    "debug_log": true,
    "archetype_tone_boost": 3.0,
    "_archetype_tone_boost": "[D] weight multiplier for skin tones EA tagged for the Sim's archetype (undertone); lightness still comes from the data",
    "face_presets": true,
    "_face_presets": "Apply EA face presets (eyes, nose, mouth) tagged for the Sim's archetype, drawn among every preset carrying the tag",
